[Unit]
Description=OuijaCNC FluidNC web controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spirit
Group=spirit
WorkingDirectory=/home/spirit/ouijacnc
Environment=FLASK_APP=ouijacnc.web
ExecStart=/home/spirit/ouijacnc/.venv/bin/flask --app ouijacnc.web run --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
