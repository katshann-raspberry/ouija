[Unit]
Description=OuijaCNC FluidNC web controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/ouijacnc
Environment=FLASK_APP=ouijacnc.web
ExecStart=/home/pi/ouijacnc/.venv/bin/flask --app ouijacnc.web run --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
